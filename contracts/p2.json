        },
        "schemaVersion": {
          "const": 1
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^session:[A-Za-z0-9_-]{1,128}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurredAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "producer": {
          "const": "streaming"
        },
        "payload": {
          "$ref": "#/$defs/P2StreamSessionChangedPayload"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "eventId",
        "eventType",
        "schemaVersion",
