          "userId": "usr_fixture",
          "accountVersion": 1,
          "status": "SUSPENDED"
        }
      ]
    },
    "P2EventAccountStatusChanged": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "account.status.changed.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^account:[A-Za-z0-9_-]{1,64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurredAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "producer": {
          "const": "core"
        },
        "payload": {
          "$ref": "#/$defs/P2AccountStatusPayload"
        },
