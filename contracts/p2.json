    "P2SubtitleUploadMetadata": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])\\S(?:.*\\S)?$"
        },
        "expectedMappingVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "language",
        "label",
        "expectedMappingVersion"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "language": "es",
          "label": "Español",
          "expectedMappingVersion": 1
        }
      ]
    },
