          "vodId": "vod_fixture",
          "language": "es",
          "label": "Español",
          "kind": "subtitles",
          "format": "WEBVTT",
          "state": "READY",
          "trackVersion": 1,
          "mappingVersion": 1,
          "mediaDurationMs": 12000,
          "contentPath": "/vod-media/vod_fixture/subtitles/sub_fixture.vtt"
        }
      ]
    },
