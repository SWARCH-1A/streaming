              "channelVersion": 0
            }
          ],
          "nextCursor": null
        }
      ]
    },
    "P2AccountStatusCommand": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ACTIVE",
            "SUSPENDED"
          ]
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "expectedVersion",
        "reason"
