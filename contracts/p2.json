    "P2AccountStatusPayload": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "accountVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUSPENDED"
          ]
        }
      },
      "required": [
        "userId",
        "accountVersion",
        "status"
      ],
      "additionalProperties": false,
      "examples": [
