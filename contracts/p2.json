{
  "version": 2,
  "extends": "p1.json",
  "coverage": "Lifecycle, Discovery and password recovery contracts; other P2 families remain pending their owners.",
  "schemas": {
    "P2StreamSessionChangedPayload": {
      "type": "object",
      "properties": {
        "streamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "streamGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "PREPARING",
            "LIVE",
            "RECONNECT_GRACE",
            "ENDED"
          ]
        },
        "availability": {
          "enum": [
            "OFFLINE",
            "PLAYABLE",
            "RECONNECTING"
          ]
        },
        "channelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "firstLiveAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "initialLive": {
          "type": "boolean"
        }
      },
      "required": [
        "streamId",
        "sessionId",
        "streamGeneration",
        "sessionVersion",
        "status",
        "availability",
        "channelId",
        "firstLiveAtUtc",
        "initialLive"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "initialLive": {
                "const": true
              }
            },
            "required": [
              "initialLive"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "LIVE"
              },
              "availability": {
                "const": "PLAYABLE"
              },
              "firstLiveAtUtc": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PREPARING"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "OFFLINE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "LIVE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "PLAYABLE"
              },
              "firstLiveAtUtc": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "RECONNECT_GRACE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "RECONNECTING"
              },
              "firstLiveAtUtc": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ENDED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "OFFLINE"
              }
            }
          }
        }
      ]
    },
    "P2EventStreamSessionChanged": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "stream.session.changed.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^session:[A-Za-z0-9_-]{1,128}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurredAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "producer": {
          "const": "streaming"
        },
        "payload": {
          "$ref": "#/$defs/P2StreamSessionChangedPayload"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "eventId",
        "eventType",
        "schemaVersion",
        "aggregateId",
        "sequence",
        "occurredAtUtc",
        "producer",
        "payload",
        "correlationId"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "eventId": "00000000-0000-4000-8000-000000000001",
          "eventType": "stream.session.changed.v1",
          "schemaVersion": 1,
          "aggregateId": "session:ses_fixture",
          "sequence": 1,
          "occurredAtUtc": "2026-10-08T20:00:00Z",
          "producer": "streaming",
          "payload": {
            "streamId": "str_fixture",
            "sessionId": "ses_fixture",
            "streamGeneration": 1,
            "sessionVersion": 1,
            "status": "PREPARING",
            "availability": "OFFLINE",
            "channelId": "chn_fixture",
            "firstLiveAtUtc": null,
            "initialLive": false
          },
          "correlationId": "00000000-0000-4000-8000-000000000001"
        },
        {
          "eventId": "00000000-0000-4000-8000-000000000002",
          "eventType": "stream.session.changed.v1",
          "schemaVersion": 1,
          "aggregateId": "session:ses_fixture",
          "sequence": 2,
          "occurredAtUtc": "2026-10-08T20:00:01Z",
          "producer": "streaming",
          "payload": {
            "streamId": "str_fixture",
            "sessionId": "ses_fixture",
            "streamGeneration": 1,
            "sessionVersion": 2,
            "status": "LIVE",
            "availability": "PLAYABLE",
            "channelId": "chn_fixture",
            "firstLiveAtUtc": "2026-10-08T20:00:01Z",
            "initialLive": true
          },
          "correlationId": "00000000-0000-4000-8000-000000000002"
        },
        {
          "eventId": "00000000-0000-4000-8000-000000000003",
          "eventType": "stream.session.changed.v1",
          "schemaVersion": 1,
          "aggregateId": "session:ses_fixture",
          "sequence": 3,
          "occurredAtUtc": "2026-10-08T20:00:02Z",
          "producer": "streaming",
          "payload": {
            "streamId": "str_fixture",
            "sessionId": "ses_fixture",
            "streamGeneration": 1,
            "sessionVersion": 3,
            "status": "RECONNECT_GRACE",
            "availability": "RECONNECTING",
            "channelId": "chn_fixture",
            "firstLiveAtUtc": "2026-10-08T20:00:01Z",
            "initialLive": false
          },
          "correlationId": "00000000-0000-4000-8000-000000000003"
        },
        {
          "eventId": "00000000-0000-4000-8000-000000000004",
          "eventType": "stream.session.changed.v1",
          "schemaVersion": 1,
          "aggregateId": "session:ses_fixture",
          "sequence": 4,
          "occurredAtUtc": "2026-10-08T20:00:03Z",
          "producer": "streaming",
          "payload": {
            "streamId": "str_fixture",
            "sessionId": "ses_fixture",
            "streamGeneration": 1,
            "sessionVersion": 4,
            "status": "LIVE",
            "availability": "PLAYABLE",
            "channelId": "chn_fixture",
            "firstLiveAtUtc": "2026-10-08T20:00:01Z",
            "initialLive": false
          },
          "correlationId": "00000000-0000-4000-8000-000000000004"
        },
        {
          "eventId": "00000000-0000-4000-8000-000000000005",
          "eventType": "stream.session.changed.v1",
          "schemaVersion": 1,
          "aggregateId": "session:ses_fixture",
          "sequence": 5,
          "occurredAtUtc": "2026-10-08T20:00:04Z",
          "producer": "streaming",
          "payload": {
            "streamId": "str_fixture",
            "sessionId": "ses_fixture",
            "streamGeneration": 1,
            "sessionVersion": 5,
            "status": "ENDED",
            "availability": "OFFLINE",
            "channelId": "chn_fixture",
            "firstLiveAtUtc": "2026-10-08T20:00:01Z",
            "initialLive": false
          },
          "correlationId": "00000000-0000-4000-8000-000000000005"
        }
      ]
    },
    "P2EventStreamDiscoverySnapshot": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "stream.discovery.snapshot.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^stream:[A-Za-z0-9_-]{1,128}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurredAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "producer": {
          "const": "streaming"
        },
        "payload": {
          "$ref": "#/$defs/DiscoverySnapshot"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "eventId",
        "eventType",
        "schemaVersion",
        "aggregateId",
        "sequence",
        "occurredAtUtc",
        "producer",
        "payload",
        "correlationId"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "eventId": "00000000-0000-4000-8000-000000000001",
          "eventType": "stream.discovery.snapshot.v1",
          "schemaVersion": 1,
          "aggregateId": "stream:str_fixture",
          "sequence": 1,
          "occurredAtUtc": "2026-10-08T20:00:00Z",
          "producer": "streaming",
          "payload": {
            "streamId": "str_fixture",
            "channelId": "chn_fixture",
            "sessionId": "ses_fixture",
            "streamGeneration": 1,
            "title": "Conversación",
            "category": {
              "id": "cat_00000000000000000000000000000001",
              "name": "Conversación"
            },
            "tags": [],
            "status": "LIVE",
            "availability": "PLAYABLE",
            "metadataVersion": 1,
            "sessionVersion": 1,
            "viewerCount": 1,
            "countVersion": 1,
            "viewerCountObservedAtUtc": "2026-10-08T20:00:00Z",
            "projectionVersion": 1,
            "discoveryPosition": 1,
            "startedAtUtc": "2026-10-08T20:00:00Z",
            "stateObservedAtUtc": "2026-10-08T20:00:00Z"
          },
          "correlationId": "00000000-0000-4000-8000-000000000001"
        }
      ]
    },
    "P2RecoveryRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "email": "fixture@example.test"
        }
      ]
    },
    "P2RecoveryAccepted": {
      "type": "object",
      "properties": {
        "message": {
          "const": "Si existe una cuenta asociada, recibirás un correo para restablecer la contraseña."
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "message": "Si existe una cuenta asociada, recibirás un correo para restablecer la contraseña."
        }
      ]
    },
    "P2RecoveryConfirm": {
      "type": "object",
      "properties": {
        "recoveryToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "newPassword": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        }
      },
      "required": [
        "recoveryToken",
        "newPassword"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "recoveryToken": "ccccccccccccccccccccccccccccccccccccccccccc",
          "newPassword": "Fictitious-new-password-123"
        }
      ]
    },
    "P2RecoveryClaim": {
      "type": "object",
      "properties": {
        "deliveryId": {
          "type": "string",
          "pattern": "^del_[A-Za-z0-9_-]{32}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "deliveryId",
        "attempt"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "deliveryId": "del_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "attempt": 1
        }
      ]
    },
    "P2RecoveryDelivery": {
      "type": "object",
      "properties": {
        "recoveryId": {
          "type": "string",
          "pattern": "^rec_[A-Za-z0-9_-]{32}$"
        },
        "deliveryId": {
          "type": "string",
          "pattern": "^del_[A-Za-z0-9_-]{32}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^[^\\r\\n]+$"
        },
        "resetUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "expiresAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "recoveryId",
        "deliveryId",
        "attempt",
        "recipient",
        "resetUrl",
        "expiresAtUtc"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "recoveryId": "rec_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "deliveryId": "del_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "attempt": 1,
          "recipient": "fixture@example.test",
          "resetUrl": "https://vault.example.test/reset-password#token=ccccccccccccccccccccccccccccccccccccccccccc",
          "expiresAtUtc": "2026-10-22T18:30:00Z"
        }
      ]
    },
    "P2DeliveryResult": {
      "type": "object",
      "properties": {
        "deliveryId": {
          "type": "string",
          "pattern": "^del_[A-Za-z0-9_-]{32}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "status": {
          "enum": [
            "DELIVERED",
            "RETRYABLE_FAILURE",
            "PERMANENT_FAILURE",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "deliveryId",
        "attempt",
        "status"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "deliveryId": "del_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "attempt": 1,
          "status": "DELIVERED"
        }
      ]
    },
    "P2EventCredentialRecoveryDeliveryRequested": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "credential.recovery.delivery.requested.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "core"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^recovery:rec_[A-Za-z0-9_-]{32}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurredAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "recoveryId": {
              "type": "string",
              "pattern": "^rec_[A-Za-z0-9_-]{32}$"
            },
            "deliveryId": {
              "type": "string",
              "pattern": "^del_[A-Za-z0-9_-]{32}$"
            }
          },
          "required": [
            "recoveryId",
            "deliveryId"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "recoveryId": "rec_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "deliveryId": "del_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            }
          ]
        }
      },
      "required": [
        "eventId",
        "eventType",
        "schemaVersion",
        "producer",
        "aggregateId",
        "sequence",
        "occurredAtUtc",
        "correlationId",
        "payload"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "eventId": "11111111-1111-4111-8111-111111111111",
          "eventType": "credential.recovery.delivery.requested.v1",
          "schemaVersion": 1,
          "producer": "core",
          "aggregateId": "recovery:rec_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "sequence": 1,
          "occurredAtUtc": "2026-10-22T18:00:00Z",
          "correlationId": "req_fixture",
          "payload": {
            "recoveryId": "rec_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "deliveryId": "del_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        }
      ]
    },
    "P2AccountAdmin": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "handle": {
          "type": "string",
          "minLength": 4,
          "maxLength": 25
        },
