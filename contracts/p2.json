          "nextCursor": null
        }
      ]
    },
    "P2ChannelAdminPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/P2ChannelAdmin"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "items": [
            {
              "channelId": "chn_fixture",
