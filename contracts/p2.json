{
  "version": 2,
  "extends": "p1.json",
  "coverage": "Lifecycle/Discovery and Core Administration contracts. Account status is produced by Core; enforcement in other services and remaining P2 HTTP/WS/media interfaces are pending.",
  "schemas": {
    "P2StreamSessionChangedPayload": {
      "type": "object",
      "properties": {
        "streamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "streamGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "PREPARING",
            "LIVE",
            "RECONNECT_GRACE",
            "ENDED"
          ]
        },
        "availability": {
          "enum": [
            "OFFLINE",
            "PLAYABLE",
            "RECONNECTING"
          ]
        },
        "channelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "firstLiveAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "initialLive": {
          "type": "boolean"
        }
      },
      "required": [
        "streamId",
        "sessionId",
        "streamGeneration",
        "sessionVersion",
        "status",
        "availability",
        "channelId",
        "firstLiveAtUtc",
        "initialLive"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "initialLive": {
                "const": true
              }
            },
            "required": [
              "initialLive"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "LIVE"
              },
              "availability": {
                "const": "PLAYABLE"
              },
              "firstLiveAtUtc": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PREPARING"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "OFFLINE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "LIVE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "PLAYABLE"
              },
              "firstLiveAtUtc": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "RECONNECT_GRACE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "RECONNECTING"
              },
              "firstLiveAtUtc": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ENDED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "OFFLINE"
              }
            }
          }
        }
      ]
    },
    "P2EventStreamSessionChanged": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
