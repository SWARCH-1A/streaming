          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])\\S(?:.*\\S)?$"
        },
        "kind": {
          "const": "subtitles"
        },
        "format": {
          "const": "WEBVTT"
        },
        "state": {
          "const": "READY"
        },
        "trackVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mappingVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mediaDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentPath": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^/vod-media/[A-Za-z0-9_-]{1,128}/subtitles/[A-Za-z0-9_-]{1,128}\\.vtt$"
        }
      },
      "required": [
        "trackId",
        "vodId",
        "language",
        "label",
        "kind",
        "format",
        "state",
        "trackVersion",
        "mappingVersion",
        "mediaDurationMs",
        "contentPath"
      ],
