{
  admin off
  auto_https off
  # Runtime upstream errors must not include cookies, credentials or query strings.
  log default {
    format filter {
      request delete
      resp_headers delete
      wrap json
    }
  }
}

(proxy_headers) {
  header_up -X-Service-Name
  header_up -X-Service-Token
  header_up -X-Session-Credential
  header_up -Forwarded
  header_up X-Forwarded-For {remote_host}
  header_up X-Real-IP {remote_host}
  header_up X-Forwarded-Proto {scheme}
  header_up X-Forwarded-Host {host}
}

:3000 {
  root * /srv
  header X-Content-Type-Options nosniff
  header Referrer-Policy same-origin
  route {
    @private path /internal /internal/* /actuator /actuator/* /health /health/* /readyz /livez /metrics
    respond @private 404
    @channel_streams {
      method GET POST
      path_regexp channel_streams ^/api/channels/[A-Za-z0-9_-]+/streams$
    }
    reverse_proxy @channel_streams {$STREAMING_UPSTREAM:http://streaming:8080} {
      import proxy_headers
    }
    @streaming path /api/streams/*
    reverse_proxy @streaming {$STREAMING_UPSTREAM:http://streaming:8080} {
      import proxy_headers
    }
    @chat_history {
      method GET
      path_regexp chat_history ^/api/chat/sessions/[A-Za-z0-9_-]+/messages$
    }
    reverse_proxy @chat_history {$CHAT_UPSTREAM:http://chat:8085} {
      import proxy_headers
    }
    @chat_ws {
      method GET
      path_regexp chat_ws ^/realtime/chat/sessions/[A-Za-z0-9_-]+$
    }
    reverse_proxy @chat_ws {$CHAT_UPSTREAM:http://chat:8085} {
      import proxy_headers
      stream_close_delay 5s
    }
    @hls {
      method GET HEAD
      path_regexp hls ^/hls/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$
    }
    reverse_proxy @hls {$HLS_UPSTREAM:http://streaming:8888} {
      import proxy_headers
      # Media owns availability, byte ranges, MIME types and playlist/segment cache policy.
    }
    @core path /api/identity/* /api/profile/* /api/channels/* /api/taxonomy /api/discovery/graphql
    reverse_proxy @core {$CORE_UPSTREAM:http://core:8081} {
      import proxy_headers
      transport http {
        response_header_timeout 10s
      }
    }
    @api path /api /api/* /realtime /realtime/* /hls /hls/*
    header @api Content-Type application/json
    respond @api `{"code":"NOT_FOUND","message":"Ruta no encontrada.","requestId":"proxy"}` 404
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    file_server @assets
    @spa {
      method GET HEAD
      path / /search /login /register /profile /studio /studio/channel /channels/* /watch/* /design-system /design-system/* /prototype
      header Accept *text/html*
    }
    handle @spa {
      rewrite * /index.html
      header Cache-Control no-cache
      file_server
    }
    respond 404
  }
  handle_errors {
    header Content-Type application/json
    respond `{"code":"UPSTREAM_UNAVAILABLE","message":"Servicio no disponible.","requestId":"proxy"}` 503
  }
}
