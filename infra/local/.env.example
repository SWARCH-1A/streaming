# Copy to infra/local/.env and supply local values; this template cannot start as-is.
CORE_DB_PASSWORD=
CORE_RATE_LIMIT_HMAC_SECRET=
CORE_DB_PORT=5440
CORE_PORT=8081
CORE_SECURE_COOKIE=false
WEB_ORIGIN=http://localhost:3000
# S3 is the default. Configure an existing private bucket and credentials/role before starting Core.
CORE_IMAGE_STORAGE_PROVIDER=s3
CORE_IMAGE_S3_BUCKET=
CORE_IMAGE_S3_REGION=us-east-1
CORE_IMAGE_S3_ENDPOINT=
CORE_IMAGE_S3_PATH_STYLE_ACCESS=false
CORE_IMAGE_S3_AVATAR_PREFIX=avatars
CORE_IMAGE_S3_BANNER_PREFIX=banners
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PROFILE_AVATAR_PUBLIC_BASE=/api/profile/avatars
CHANNELS_BANNER_PUBLIC_BASE=/api/channels/banners

# Chat (compose.chat.yaml): secretos distintos por ruta interna, al menos 32 bytes aleatorios.
CHAT_CORE_SERVICE_TOKEN=
CHAT_SESSION_EVENTS_TOKEN=
CHAT_PORT=8085
CHAT_INTERNAL_PORT=8086
# Private Core listener is off unless a private overlay is explicitly selected.
CORE_STREAMING_SERVICE_TOKEN=
# Optional independent credential: catalog-values only, never owner-context.
CORE_STREAMING_CATALOG_SERVICE_TOKEN=
