# Build official, pinned source releases: public prebuilt registries may be unavailable.
FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z \
    && go install github.com/minio/mc@RELEASE.2025-08-13T08-35-41Z
FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 minio && mkdir -p /data /run/minio-certs/CAs && chown -R minio /data /run/minio-certs
COPY --from=build /go/bin/minio /usr/local/bin/minio
COPY --from=build /go/bin/mc /usr/local/bin/mc
USER minio
EXPOSE 9000
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--address", ":9000", "--certs-dir", "/run/minio-certs"]
